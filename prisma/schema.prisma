// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SUPERADMIN
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DELETION_PENDING
  SUSPENDED
}

enum IdentityProvider {
  PHONE
  GOOGLE
  APPLE
}

enum OtpPurpose {
  SIGN_UP
  SIGN_IN
  LINK_PHONE
}

enum Language {
  UZ
  EN
  RU
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  NEW_FOLLOWER
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  POST_LIKE
  NEW_POST
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  phone             String     @unique
  password          String
  username          String?    @unique @db.VarChar(30)
  fullName          String?    @db.VarChar(100)
  bio               String?    @db.VarChar(500)
  avatarUrl         String?
  role              Roles      @default(USER)
  preferredLanguage Language   @default(UZ)
  isPrivate         Boolean    @default(false)
  isVerified        Boolean    @default(false)
  status            UserStatus @default(ACTIVE)

  deletionScheduledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  identities       UserIdentity[]
  sessions         Session[]
  otpVerifications OtpVerification[]

  posts       Post[]
  collections Collection[]

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  likes Like[]

  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationActor")

  conversationsAsUserOne Conversation[] @relation("ConversationUserOne")
  conversationsAsUserTwo Conversation[] @relation("ConversationUserTwo")
  sentMessages           Message[]      @relation("SentMessages")

  @@index([status, createdAt])
  @@map("users")
}

model UserIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  providerUserId String
  phoneNumber    String?
  email          String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
  @@map("user_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model OtpVerification {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  phoneNumber String
  codeHash    String
  purpose     OtpPurpose
  expiresAt   DateTime   @db.Timestamptz(3)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?  @db.Timestamptz(3)
  resendAt    DateTime?  @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, purpose, expiresAt])
  @@index([userId])
  @@map("otp_verifications")
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  coverUrl String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  translations CategoryTranslation[]
  posts        Post[]

  @@index([isActive])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  language    Language
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(120)
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@unique([language, slug])
  @@map("category_translations")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  translations TagTranslation[]
  posts        PostTag[]

  @@map("tags")
}

model TagTranslation {
  id       String   @id @default(uuid()) @db.Uuid
  tagId    String   @db.Uuid
  language Language
  name     String   @db.VarChar(50)
  slug     String   @db.VarChar(60)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, language])
  @@unique([language, slug])
  @@map("tag_translations")
}

// =========================
// POSTS & MEDIA
// =========================

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  categoryId     String?    @db.Uuid
  title          String?    @db.VarChar(200)
  description    String?    @db.VarChar(3000)
  destinationUrl String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?  @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  media         PostMedia[]
  tags          PostTag[]
  likes         Like[]
  notifications Notification[]

  collectionItems CollectionItem[]

  @@index([userId, createdAt])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([title])
  @@map("posts")
}

model PostMedia {
  id              String    @id @default(uuid()) @db.Uuid
  postId          String    @db.Uuid
  type            MediaType
  storageKey      String
  mimeType        String
  width           Int?
  height          Int?
  durationSeconds Int?
  fileSize        BigInt?
  position        Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([postId])
  @@map("post_media")
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model Collection {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @db.Uuid
  name        String  @db.VarChar(100)
  description String? @db.VarChar(500)
  coverUrl    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, createdAt])
  @@map("collections")
}

model CollectionItem {
  id           String @id @default(uuid()) @db.Uuid
  collectionId String @db.Uuid
  postId       String @db.Uuid
  position     Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([collectionId, postId])
  @@index([collectionId, position])
  @@map("collection_items")
}

model Follow {
  id          String       @id @default(uuid()) @db.Uuid
  followerId  String       @db.Uuid
  followingId String       @db.Uuid
  status      FollowStatus @default(ACCEPTED)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
  @@map("follows")
}

model Like {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  postId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@map("likes")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @db.Uuid
  actorId     String?          @db.Uuid
  postId      String?          @db.Uuid
  type        NotificationType
  message     String?          @db.VarChar(500)
  readAt      DateTime?        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

// =========================
// CHAT & MESSAGES
// =========================

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  userOneId     String   @db.Uuid
  userTwoId     String   @db.Uuid
  lastMessageAt DateTime @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  userOne  User      @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, lastMessageAt])
  @@index([userTwoId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String    @db.VarChar(3000)
  isRead         Boolean   @default(false)
  readAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
